# Documentation only. The app does not load .env files automatically.
# Set secrets in your shell or hosting provider environment.
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-16-characters
GOOGLE_SHEETS_FEEDBACK_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_FEEDBACK_TOKEN=replace-with-the-shared-token-from-google-apps-script
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional; 0 disables periodic PostgreSQL pings. For example, 180000 = 3 minutes.
DATABASE_KEEPALIVE_INTERVAL_MS=0
APP_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM="OmeTalk <no-reply@example.com>"